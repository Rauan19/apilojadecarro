# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Origens permitidas no CORS (separar por vírgula). Produção:
# FRONTEND_URL=https://estoqueauto.com,https://www.estoqueauto.com
FRONTEND_URL=http://localhost:5173,http://localhost:5174
APP_NAME=EstoqueAuto

# Database (PostgreSQL via docker compose)
# Suba o banco: npm run db:up
# Porta 65432 evita conflito com Postgres instalado no Windows (5432)
DATABASE_URL="postgresql://lojadecarro:lojadecarro@127.0.0.1:65432/lojadecarro?schema=public"

# JWT
JWT_SECRET=change-this-super-secret-jwt-key-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-super-secret-refresh-key-in-production-min-32
JWT_REFRESH_EXPIRES_IN=7d

# Upload
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=5242880

# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Consulta por placa (Invertexto). Sem token, em development usa dados demo.
# PLATE_API_TOKEN=
PLATE_LOOKUP_DEMO=true

# Bot WhatsApp (Evolution API rodando via docker compose em evolutionapi/)
EVOLUTION_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=evo_local_dev_key_change_in_prod
# URL do webhook alcançável DE DENTRO do container da Evolution (dev Windows/Docker)
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:3000/api/whatsapp/webhook
# Base usada para montar a URL das fotos de veículos enviadas ao cliente (mesma razão acima)
EVOLUTION_MEDIA_BASE_URL=http://host.docker.internal:3000

# Mercado Pago — mensalidade do sistema paga pela loja (aba Assinatura)
# Credenciais em: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=
# Assinatura do webhook (painel MP > Webhooks > "Chave secreta")
MP_WEBHOOK_SECRET=
# Em dev o MP não alcança localhost: use ngrok e cole a URL pública aqui.
# MP_WEBHOOK_URL=https://xxxx.ngrok-free.app/api/billing/webhooks/mercadopago

# Regras de cobrança
BILLING_CYCLE_DAYS=30
BILLING_ISSUE_DAYS_BEFORE=3
BILLING_PIX_EXPIRES_DAYS=3
BILLING_GRACE_DAYS=5
BILLING_CRON_HOUR=9
BILLING_TIMEZONE=America/Sao_Paulo
# Só sandbox: envia a cobrança como pagamento de teste que o MP aprova sozinho
# (o sandbox não permite pagar um PIX de verdade). NUNCA ligar em produção.
MP_TEST_FORCE_APPROVE=false
