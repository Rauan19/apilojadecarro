# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
APP_NAME=LojaDeCarro SaaS

# Database (SQLite - change provider to postgresql and URL for production)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET=change-this-super-secret-jwt-key-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-super-secret-refresh-key-in-production-min-32
JWT_REFRESH_EXPIRES_IN=7d

# Upload
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=5242880

# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=100
